  "requiredMarkers": [
    {
      "id": "configuration-foreign-keys-passed",
      "regex": "\\[Configuration\\]: Validating Foreign Key Constraints\\.\\.\\.[\\s\\S]*?\\[Configuration\\]: Passed Validation\\.",
      "minimumOccurrences": 1,
      "rationale": "The configuration database must complete foreign-key validation."
    },
    {
      "id": "gameplay-foreign-keys-passed",
      "regex": "\\[Gameplay\\]: Validating Foreign Key Constraints\\.\\.\\.[\\s\\S]*?\\[Gameplay\\]: Passed Validation\\.",
      "minimumOccurrences": 1,
      "rationale": "The gameplay database must complete foreign-key validation."
    },
    {
      "id": "localization-foreign-keys-passed",
      "regex": "\\[Localization\\]: Validating Foreign Key Constraints\\.\\.\\.[\\s\\S]*?\\[Localization\\]: Passed Validation\\.",
      "minimumOccurrences": 1,
      "rationale": "The localization database must complete foreign-key validation."
