  ],
  "allowedErrorRules": [
    {
      "id": "firaxis-current-clickout-duplicate",
      "scope": "Localization",
      "messageRegex": "^UNIQUE constraint failed: LocalizedText\\.Language, LocalizedText\\.Tag$",
      "contextRegexes": [
        "LOC_CLICKOUT_26_CAROUSEL_TOOLTIP",
        "insert into BaseGameText",
        "CurrentClickouts[\\\\/][0-9a-f-]+[\\\\/]Text[\\\\/]ClickoutText_en_US\\.xml"
      ],
      "contextFileRegex": "^CurrentClickouts[\\\\/][0-9a-f-]+[\\\\/]Text[\\\\/]ClickoutText_en_US\\.xml$",
      "requireContextFile": true,
      "rationale": "Firaxis Live can enqueue the same stock carousel clickout through multiple UUID folders; this is external localization noise and is never allowed to cover Gameplay or project files."
    }
  ]
